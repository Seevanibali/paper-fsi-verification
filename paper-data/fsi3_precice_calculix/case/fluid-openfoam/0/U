FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        // FSI3: parabolic profile, maximum 3 m/s (mean 2 m/s), impulsive start
        // (as solids4foam: transitionalParabolicVelocity, maxValue 3, transitionPeriod 0)
        type            codedFixedValue;
        value           uniform (0 0 0);
        name            fsi3ParabolicInlet;
        code
        #{
            const scalar H = 0.41;
            const scalar Umax = 3.0;
            const vectorField& Cf = patch().Cf();
            vectorField& field = *this;
            forAll(Cf, faceI)
            {
                const scalar y = Cf[faceI].y();
                field[faceI] = vector(Umax*4.0*y*(H - y)/(H*H), 0, 0);
            }
        #};
    }
    outlet              { type zeroGradient; }
    plate               { type movingWallVelocity; value uniform (0 0 0); }
    cylinder            { type noSlip; }
    top                 { type noSlip; }
    bottom              { type noSlip; }
    frontAndBackPlanes  { type empty; }
}
